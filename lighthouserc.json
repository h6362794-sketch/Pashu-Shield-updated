{
  "ci": {
    "collect": { "url": ["http://localhost:8080/", "http://localhost:8080/#/about", "http://localhost:8080/#/help", "http://localhost:8080/#/search"],
                 "numberOfRuns": 3, "settings": { "preset": "desktop", "formFactor": "mobile", "screenEmulation": { "mobile": true, "width": 360, "height": 640, "deviceScaleFactor": 2, "disabled": false }, "throttlingMethod": "simulate" } },
    "assert": { "assertions": {
      "categories:performance": ["error", { "minScore": 0.9 }],
      "categories:accessibility": ["error", { "minScore": 1 }],
      "categories:best-practices": ["error", { "minScore": 0.95 }],
      "categories:seo": ["error", { "minScore": 0.95 }],
      "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
      "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
      "interaction-to-next-paint": ["warn", { "maxNumericValue": 200 }]
    } }
  }
}
